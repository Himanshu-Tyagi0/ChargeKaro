# ChargeKaro Environment Variables (Demo Sandbox)
ENVIRONMENT=development
DATABASE_URL=sqlite:///./chargekaro.db

# Replace with strong 32+ byte random secrets in production
JWT_SECRET=replace-with-32-byte-random-secret-key
QR_SECRET=replace-with-32-byte-qr-signing-secret
CSRF_SECRET=replace-with-32-byte-csrf-signing-secret

# CORS & Frontend origin
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# AI Provider ("gemini" | "groq" | "rule")
LLM_PROVIDER=gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=gemini-4-hydrogen
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile

# Live status simulator
ENABLE_SIMULATOR=true
APP_URL="MY_APP_URL"

# Optional external FastAPI URL when deploying frontend separately on static hosts (e.g. Vercel + Render)
# VITE_API_BASE_URL="https://your-fastapi-backend.onrender.com"
